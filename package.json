{
  "name": "dr-ak-dhar-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-sitemap.mjs && next build",
    "translate": "tsx scripts/translate.mjs",
    "translate:dry-run": "tsx scripts/translate.mjs --dry-run",
    "translate:shared": "tsx scripts/translate.mjs --scope=shared-ui",
    "translate:home": "tsx scripts/translate.mjs --scope=shared-ui,home",
    "translate:about": "tsx scripts/translate.mjs --scope=about",
    "translate:treatments": "tsx scripts/translate.mjs --scope=treatments",
    "translate:blogs": "tsx scripts/translate.mjs --scope=blogs",
    "translate:contact": "tsx scripts/translate.mjs --scope=contact",
    "test:cms": "tsx scripts/test-cms-connection.mts",
    "export:seed": "tsx scripts/export-cms-seed.mts",
    "start": "python3 -m http.server 3000 -d out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "typescript": "^5.9.3"
  }
}
